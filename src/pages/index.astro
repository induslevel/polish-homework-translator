---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Polish Homework Buddy | Side-by-Side Bilingual Document Reader">
  <div class="min-h-screen bg-[#070B14] text-slate-100 flex flex-col font-sans selection:bg-indigo-500 selection:text-white">
    
    <!-- Top Action & Navigation Bar -->
    <header class="border-b border-slate-800 bg-[#0D1322]/95 backdrop-blur-md sticky top-0 z-50">
      <div class="container mx-auto px-4 py-3 max-w-[98%] flex flex-wrap justify-between items-center gap-3">
        
        <!-- Left: App Title & Status -->
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-red-500 via-white to-indigo-600 flex items-center justify-center shadow-md shadow-red-500/20 text-base font-bold text-slate-900 border border-white/20">
            🇵🇱
          </div>
          <div>
            <h1 class="font-extrabold text-sm sm:text-base tracking-tight text-white flex items-center gap-2">
              Polish Homework Buddy <span class="text-[10px] px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 font-mono">Side-by-Side</span>
            </h1>
            <p class="text-[10px] text-slate-400 font-medium">Bilingual Document Viewer with Instant Word & Sentence Speech</p>
          </div>
        </div>

        <!-- Center / Right: Interactive Controls -->
        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
          
          <!-- Font Size Adjuster -->
          <div class="flex items-center bg-[#131A2E] border border-slate-800 rounded-xl px-2 py-1 gap-1 text-xs">
            <span class="text-[10px] text-slate-400">Size:</span>
            <button id="btn-font-dec" class="px-2 py-0.5 rounded hover:bg-slate-700 text-slate-300 font-bold">A-</button>
            <button id="btn-font-inc" class="px-2 py-0.5 rounded hover:bg-slate-700 text-slate-300 font-bold">A+</button>
          </div>

          <!-- Speech Speed Rate -->
          <div class="flex items-center bg-[#131A2E] border border-slate-800 rounded-xl px-2.5 py-1.5 gap-1.5 text-xs">
            <span class="text-slate-400">Speed:</span>
            <select id="tts-rate" class="bg-transparent text-xs font-bold text-white focus:outline-none cursor-pointer">
              <option value="0.75" class="bg-[#131A2E]">🐢 0.75x (Learning)</option>
              <option value="0.9" class="bg-[#131A2E]" selected>🎯 0.9x (Ideal)</option>
              <option value="1.0" class="bg-[#131A2E]">⚡ 1.0x (Normal)</option>
            </select>
          </div>

          <!-- Synchronized Scroll Switch -->
          <label class="hidden md:flex items-center gap-1.5 bg-[#131A2E] border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-slate-300 cursor-pointer select-none">
            <input type="checkbox" id="chk-sync-scroll" checked class="form-checkbox rounded text-indigo-500 focus:ring-0">
            <span>🔗 Sync Scroll</span>
          </label>

          <!-- Preloaded Homework Demos -->
          <div class="flex items-center bg-[#131A2E] border border-slate-800 rounded-xl px-2.5 py-1.5 gap-1.5 text-xs">
            <span class="text-slate-400">Demos:</span>
            <select id="sample-select" class="bg-transparent text-xs font-bold text-indigo-400 focus:outline-none cursor-pointer">
              <option value="" disabled selected>Load Demo...</option>
              <option value="math" class="bg-[#131A2E]">🔢 Matematyka (Math Problem)</option>
              <option value="nature" class="bg-[#131A2E]">🌿 Przyroda (Bocian biały)</option>
              <option value="story" class="bg-[#131A2E]">🐲 Czytanka (Smok Płomyk)</option>
            </select>
          </div>

          <!-- Upload PDF Button -->
          <label class="cursor-pointer px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-md shadow-indigo-600/20">
            <span>📂 Upload PDF</span>
            <input type="file" id="pdf-file-input" accept="application/pdf,image/*" class="hidden" />
          </label>

          <!-- Paste Text Button -->
          <button id="btn-paste-modal" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs border border-slate-700 transition-all">
            ✍️ Paste Text
          </button>
        </div>

      </div>
    </header>

    <!-- Side-by-Side Dual Document Panels -->
    <main class="container mx-auto px-2 sm:px-4 py-4 max-w-[98%] flex-grow flex flex-col">
      
      <!-- Top Document Bar (Read All & Document Status) -->
      <div id="status-bar" class="mb-3 px-4 py-2.5 rounded-2xl bg-[#0F1629] border border-slate-800 flex justify-between items-center text-xs">
        <div class="flex items-center gap-2 sm:gap-3">
          <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
            ● Document Active
          </span>
          <span id="doc-title" class="font-bold text-white truncate max-w-xs sm:max-w-md">Zadanie z Matematyki - Owoce w koszyku</span>
          <span id="paragraph-count" class="text-slate-400 hidden sm:inline">5 paragraphs</span>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-slate-400 hidden lg:inline">Click <b>any word</b> to pronounce it!</span>
          <button id="btn-read-all" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-red-600 to-indigo-600 hover:from-red-500 hover:to-indigo-500 text-white font-extrabold text-xs flex items-center gap-1.5 transition-all shadow-md shadow-indigo-600/20">
            <span>▶️ Play Entire Document (PL ➔ EN)</span>
          </button>
        </div>
      </div>

      <!-- SIDE-BY-SIDE PANELS (50/50 SPLIT) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 flex-grow items-stretch">
        
        <!-- LEFT PANEL: POLISH ORIGINAL DOCUMENT -->
        <div class="bg-[#0E1528] border border-slate-800 rounded-3xl p-5 sm:p-7 flex flex-col shadow-2xl relative overflow-hidden">
          
          <!-- Panel Header -->
          <div class="flex justify-between items-center border-b border-slate-800 pb-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🇵🇱</span>
              <div>
                <h2 class="text-sm sm:text-base font-extrabold text-white">JĘZYK POLSKI (DOKUMENT ORYGINALNY)</h2>
                <p class="text-[10px] text-slate-400">Native Polish Syntax & Audio (pl-PL)</p>
              </div>
            </div>
            <span class="text-[10px] font-mono font-bold text-red-400 bg-red-500/10 border border-red-500/20 px-2.5 py-0.5 rounded-full">
              ORYGINAŁ
            </span>
          </div>

          <!-- Document Paper Body -->
          <div id="doc-panel-polish" class="document-paper flex-grow overflow-y-auto pr-2 space-y-4 max-h-[76vh] text-base leading-relaxed select-text">
            <!-- Populated dynamically with paragraphs -->
          </div>
        </div>

        <!-- RIGHT PANEL: ENGLISH TRANSLATED DOCUMENT -->
        <div class="bg-[#0E1528] border border-slate-800 rounded-3xl p-5 sm:p-7 flex flex-col shadow-2xl relative overflow-hidden">
          
          <!-- Panel Header -->
          <div class="flex justify-between items-center border-b border-slate-800 pb-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🇬🇧</span>
              <div>
                <h2 class="text-sm sm:text-base font-extrabold text-white">ENGLISH (TRANSLATED DOCUMENT)</h2>
                <p class="text-[10px] text-slate-400">Accurate English Translation & Audio (en-US)</p>
              </div>
            </div>
            <span class="text-[10px] font-mono font-bold text-blue-400 bg-blue-500/10 border border-blue-500/20 px-2.5 py-0.5 rounded-full">
              TRANSLATION
            </span>
          </div>

          <!-- Document Paper Body -->
          <div id="doc-panel-english" class="document-paper flex-grow overflow-y-auto pr-2 space-y-4 max-h-[76vh] text-base leading-relaxed select-text">
            <!-- Populated dynamically with paragraphs -->
          </div>
        </div>

      </div>

      <!-- Paste Text Modal -->
      <div id="paste-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-[#11182B] border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-2xl w-full space-y-4 shadow-2xl">
          <div class="flex justify-between items-center border-b border-slate-800 pb-3">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span>✍️</span> Paste Polish Homework Text
            </h3>
            <button id="btn-close-paste" class="text-slate-400 hover:text-white text-lg font-bold">✕</button>
          </div>

          <textarea id="paste-input" rows="8" class="w-full bg-[#0A0E1A] border border-slate-700 rounded-2xl p-4 text-sm font-sans text-white focus:outline-none focus:border-indigo-500 leading-relaxed" placeholder="Wklej treść zadania domowego po polsku..."></textarea>

          <div class="flex justify-end gap-3 pt-2">
            <button id="btn-cancel-paste" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold">Cancel</button>
            <button id="btn-submit-paste" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/20">
              ⚡ Load Document
            </button>
          </div>
        </div>
      </div>

      <!-- Floating Word Pronunciation Toast -->
      <div id="word-toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#1A233D] border border-indigo-500/40 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-xs z-50 transition-all translate-y-20 opacity-0 pointer-events-none">
        <span class="w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-white text-sm">🔊</span>
        <div>
          <span id="toast-word" class="font-extrabold text-sm text-indigo-300 block">Word</span>
          <span id="toast-lang" class="text-[10px] text-slate-400 block">Pronouncing...</span>
        </div>
      </div>

    </main>
  </div>
</Layout>

<!-- Load PDF.js from official Cloudflare CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" is:inline></script>

<script is:inline>
  if (window.pdfjsLib) {
    window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  }

  // Pre-configured Sample Datasets for Polish School
  const SAMPLES = {
    math: {
      title: "Zadanie z Matematyki - Owoce w koszyku",
      text: "Ania miała w koszyku 15 czerwonych jabłek i 8 soczystych gruszek.\nDała swojemu młodszemu bratu Tomkowi 6 jabłek na drugie śniadanie.\nNastępnie mama dołożyła do koszyka jeszcze 4 dojrzałe gruszki.\nIle wszystkich owoców znajduje się teraz w koszyku Ani?\nZapisz pełne działanie matematyczne oraz ułóż pełną odpowiedź."
    },
    nature: {
      title: "Przyroda - Bocian biały w Polsce",
      text: "Bocian biały jest jednym z najbardziej lubianych i rozpoznawalnych ptaków w Polsce.\nKażdego roku pod koniec lata bociany zbierają się w duże stada i wyruszają w długą podróż do ciepłych krajów w Afryce.\nWiosną powracają dokładnie do tych samych gniazd, które często budują na dachach domów i słupach.\nBociany żywią się głównie owadami, dżdżownicami, małymi gryzoniami oraz żabami na łąkach."
    },
    story: {
      title: "Czytanka - Mały Smok Płomyk",
      text: "Za wysokimi górami i starym lasem mieszkał mały smok o imieniu Płomyk.\nW przeciwieństwie do innych groźnych smoków, Płomyk nie lubił ziać wielkim ogniem ani nikogo straszyć.\nJego największą pasją było pieczenie pysznych ciasteczek cynamonowych dla swoich leśnych przyjaciół.\nCodziennie rano wiewiórki i zajączki przychodziły do jaskini smoka, aby wspólnie zjeść ciepłe śniadanie."
    }
  };

  // Built-in Elementary Offline Polish-English Translation Dictionary for Instant Fallback
  const DICT = {
    "ania": "Ania", "miała": "had", "w": "in", "koszyku": "the basket", "15": "15", "czerwonych": "red", "jabłek": "apples",
    "i": "and", "8": "8", "soczystych": "juicy", "gruszek": "pears", "dała": "gave", "swojemu": "her", "młodszemu": "younger",
    "bratu": "brother", "tomkowi": "Tomek", "6": "6", "na": "for", "drugie": "second", "śniadanie": "breakfast",
    "następnie": "then", "mama": "mom", "dołożyła": "added", "do": "to", "jeszcze": "another", "4": "4", "dojrzałe": "ripe",
    "gruszki": "pears", "ile": "how many", "wszystkich": "total", "owoców": "fruits", "znajduje": "are", "się": "located",
    "teraz": "now", "ani": "Ania's", "zapisz": "write down", "pełne": "full", "działanie": "calculation", "matematyczne": "mathematical",
    "oraz": "and", "ułóż": "compose", "odpowiedź": "answer", "bocian": "stork", "biały": "white", "jest": "is", "jednym": "one",
    "z": "of", "najbardziej": "most", "lubianych": "beloved", "rozpoznawalnych": "recognizable", "ptaków": "birds", "polsce": "Poland",
    "każdego": "every", "roku": "year", "pod": "at", "koniec": "the end", "lata": "of summer", "bociany": "storks", "zbierają": "gather",
    "duże": "large", "stada": "flocks", "wyruszają": "set off", "długą": "long", "podróż": "journey", "ciepłych": "warm",
    "krajów": "countries", "afryce": "Africa", "wiosną": "in spring", "powracają": "they return", "dokładnie": "exactly",
    "tych": "the", "samych": "same", "gniazd": "nests", "które": "which", "często": "often", "budują": "they build",
    "dachach": "roofs", "domów": "of houses", "słupach": "poles", "żywią": "feed", "głównie": "mainly", "owadami": "insects",
    "dżdżownicami": "earthworms", "małymi": "small", "gryzoniami": "rodents", "żabami": "frogs", "łąkach": "meadows",
    "za": "behind", "wysokimi": "tall", "górami": "mountains", "starym": "old", "lasem": "forest", "mieszkał": "lived",
    "mały": "little", "smok": "dragon", "o": "named", "imieniu": "name", "płomyk": "Płomyk (Flame)", "przeciwieństwie": "contrast",
    "innych": "other", "groźnych": "dangerous", "smoków": "dragons", "nie": "did not", "lubił": "like", "ziać": "breathe",
    "wielkim": "big", "ogniem": "fire", "ani": "nor", "nikogo": "anyone", "straszyć": "scare", "jego": "his", "największą": "greatest",
    "pasją": "passion", "było": "was", "pieczenie": "baking", "pysznych": "delicious", "ciasteczek": "cookies", "cynamonowych": "cinnamon",
    "swoich": "his", "leśnych": "forest", "przyjaciół": "friends", "codziennie": "every day", "rano": "in the morning",
    "wiewiórki": "squirrels", "zajączki": "little bunnies", "przychodziły": "came", "jaskini": "cave", "smoka": "dragon's",
    "aby": "in order to", "wspólnie": "together", "zjeść": "eat", "ciepłe": "warm"
  };

  // State
  let currentItems = [];
  let isReadingAll = false;
  let currentFontSize = 16;

  // DOM Elements
  const polishPanel = document.getElementById('doc-panel-polish');
  const englishPanel = document.getElementById('doc-panel-english');
  const fileInput = document.getElementById('pdf-file-input');
  const pasteModal = document.getElementById('paste-modal');
  const pasteInput = document.getElementById('paste-input');
  const sampleSelect = document.getElementById('sample-select');
  const syncScrollCheckbox = document.getElementById('chk-sync-scroll');

  // =========================================================================
  // 1. Web Speech Engine
  // =========================================================================
  function speakWordOrText(text, lang = 'pl-PL') {
    if (!('speechSynthesis' in window)) return;

    const rateVal = parseFloat(document.getElementById('tts-rate').value) || 0.9;
    window.speechSynthesis.cancel();

    setTimeout(() => {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = lang;
      utterance.rate = rateVal;

      const voices = window.speechSynthesis.getVoices();
      const langPrefix = lang.split('-')[0];
      const matched = voices.find(v => v.lang.toLowerCase().startsWith(langPrefix.toLowerCase()) && v.localService) 
                   || voices.find(v => v.lang.toLowerCase().startsWith(langPrefix.toLowerCase()));
      if (matched) utterance.voice = matched;

      showToast(text, lang === 'pl-PL' ? 'Polish 🇵🇱 (pl-PL)' : 'English 🇬🇧 (en-US)');
      window.speechSynthesis.speak(utterance);
    }, 50);
  }

  function showToast(word, langLabel) {
    const toast = document.getElementById('word-toast');
    document.getElementById('toast-word').textContent = word;
    document.getElementById('toast-lang').textContent = `Pronouncing in ${langLabel}...`;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => {
      toast.classList.add('translate-y-20', 'opacity-0');
    }, 2000);
  }

  // =========================================================================
  // 2. Translation & Content Processing
  // =========================================================================
  async function translateSentence(plText) {
    try {
      const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(plText)}&langpair=pl|en`;
      const res = await fetch(url);
      const data = await res.json();
      if (data?.responseData?.translatedText) {
        return data.responseData.translatedText;
      }
    } catch(e) {}

    // Fallback dictionary
    const words = plText.split(/\s+/);
    return words.map(w => {
      const clean = w.toLowerCase().replace(/[.,?!:;()]/g, '');
      const punct = w.match(/[.,?!:;()]/) ? w.match(/[.,?!:;()]/)[0] : '';
      return (DICT[clean] || w) + punct;
    }).join(' ');
  }

  async function loadDocumentText(rawText, docTitle = "Homework Document") {
    document.getElementById('doc-title').textContent = docTitle;

    const rawLines = rawText.split(/\n+/).map(l => l.trim()).filter(l => l.length > 0);
    const sentences = [];

    rawLines.forEach(line => {
      const splitSentences = line.match(/[^.!?]+[.!?]+/g) || [line];
      splitSentences.forEach(s => {
        const trimmed = s.trim();
        if (trimmed.length > 0) sentences.push(trimmed);
      });
    });

    currentItems = [];
    for (let i = 0; i < sentences.length; i++) {
      const pl = sentences[i];
      const en = await translateSentence(pl);
      currentItems.push({ id: i + 1, pl, en });
    }

    document.getElementById('paragraph-count').textContent = `${currentItems.length} sentences`;
    renderSideBySidePanels();
  }

  // =========================================================================
  // 3. Render Side-by-Side Document Panels
  // =========================================================================
  function renderSideBySidePanels() {
    polishPanel.innerHTML = '';
    englishPanel.innerHTML = '';

    currentItems.forEach(item => {
      // Polish Paragraph Block
      const plBlock = document.createElement('div');
      plBlock.id = `pl-para-${item.id}`;
      plBlock.className = 'doc-para p-4 rounded-2xl border border-slate-800/80 bg-[#12192E] hover:border-red-500/50 hover:bg-[#16203D] transition-all space-y-3';
      
      const plWordsHtml = item.pl.split(/(\s+)/).map(segment => {
        if (/^\s+$/.test(segment)) return segment;
        return `<span class="word-span hover:bg-red-500/25 hover:text-red-200 rounded px-0.5 cursor-pointer transition-colors" data-lang="pl-PL" title="Click to pronounce Polish">${segment}</span>`;
      }).join('');

      plBlock.innerHTML = `
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-red-500/10 text-red-400 font-mono text-xs font-black flex items-center justify-center shrink-0 mt-0.5 border border-red-500/20">
            ${item.id}
          </span>
          <div class="flex-1">
            <p class="text-slate-100 font-medium leading-relaxed">${plWordsHtml}</p>
          </div>
        </div>
        <div class="flex items-center justify-between pt-2 border-t border-slate-800/60 text-xs">
          <button class="btn-play-pl px-2.5 py-1 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 font-bold flex items-center gap-1" data-text="${encodeURIComponent(item.pl)}">
            <span>🔊 Posłuchaj</span>
          </button>
          <button class="btn-play-dual px-2.5 py-1 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-400 font-bold flex items-center gap-1 border border-indigo-500/30" data-idx="${item.id - 1}">
            <span>▶️ Czytaj oba (PL ➔ EN)</span>
          </button>
        </div>
      `;

      // English Paragraph Block
      const enBlock = document.createElement('div');
      enBlock.id = `en-para-${item.id}`;
      enBlock.className = 'doc-para p-4 rounded-2xl border border-slate-800/80 bg-[#12192E] hover:border-blue-500/50 hover:bg-[#16203D] transition-all space-y-3';

      const enWordsHtml = item.en.split(/(\s+)/).map(segment => {
        if (/^\s+$/.test(segment)) return segment;
        return `<span class="word-span hover:bg-blue-500/25 hover:text-blue-200 rounded px-0.5 cursor-pointer transition-colors" data-lang="en-US" title="Click to pronounce English">${segment}</span>`;
      }).join('');

      enBlock.innerHTML = `
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-blue-500/10 text-blue-400 font-mono text-xs font-black flex items-center justify-center shrink-0 mt-0.5 border border-blue-500/20">
            ${item.id}
          </span>
          <div class="flex-1">
            <p class="text-slate-100 font-medium leading-relaxed">${enWordsHtml}</p>
          </div>
        </div>
        <div class="flex items-center justify-between pt-2 border-t border-slate-800/60 text-xs">
          <button class="btn-play-en px-2.5 py-1 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 font-bold flex items-center gap-1" data-text="${encodeURIComponent(item.en)}">
            <span>🔊 Listen (EN)</span>
          </button>
          <span class="text-[10px] text-slate-500 font-mono">Paragraph #${item.id}</span>
        </div>
      `;

      // Synchronized Hover Link
      plBlock.addEventListener('mouseenter', () => enBlock.classList.add('border-indigo-500', 'bg-[#182344]'));
      plBlock.addEventListener('mouseleave', () => enBlock.classList.remove('border-indigo-500', 'bg-[#182344]'));
      enBlock.addEventListener('mouseenter', () => plBlock.classList.add('border-indigo-500', 'bg-[#182344]'));
      enBlock.addEventListener('mouseleave', () => plBlock.classList.remove('border-indigo-500', 'bg-[#182344]'));

      polishPanel.appendChild(plBlock);
      englishPanel.appendChild(enBlock);
    });

    // Word Click Events
    document.querySelectorAll('.word-span').forEach(span => {
      span.addEventListener('click', (e) => {
        e.stopPropagation();
        const word = span.textContent.trim().replace(/[.,?!:;()]/g, '');
        const lang = span.dataset.lang;
        if (word) speakWordOrText(word, lang);
      });
    });

    // Paragraph Audio Buttons
    document.querySelectorAll('.btn-play-pl').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = decodeURIComponent(btn.dataset.text);
        speakWordOrText(text, 'pl-PL');
      });
    });

    document.querySelectorAll('.btn-play-en').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = decodeURIComponent(btn.dataset.text);
        speakWordOrText(text, 'en-US');
      });
    });

    document.querySelectorAll('.btn-play-dual').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.idx, 10);
        playBilingualSequence(idx);
      });
    });
  }

  // =========================================================================
  // 4. Sequential Dual-Play Engine
  // =========================================================================
  function playBilingualSequence(idx) {
    if (idx >= currentItems.length) {
      isReadingAll = false;
      return;
    }

    const item = currentItems[idx];
    const rateVal = parseFloat(document.getElementById('tts-rate').value) || 0.9;

    document.querySelectorAll('.doc-para').forEach(p => p.classList.remove('ring-2', 'ring-indigo-500'));
    const plP = document.getElementById(`pl-para-${item.id}`);
    const enP = document.getElementById(`en-para-${item.id}`);
    if (plP) plP.classList.add('ring-2', 'ring-indigo-500');
    if (enP) enP.classList.add('ring-2', 'ring-indigo-500');

    window.speechSynthesis.cancel();

    setTimeout(() => {
      const plUtterance = new SpeechSynthesisUtterance(item.pl);
      plUtterance.lang = 'pl-PL';
      plUtterance.rate = rateVal;

      plUtterance.onend = () => {
        setTimeout(() => {
          const enUtterance = new SpeechSynthesisUtterance(item.en);
          enUtterance.lang = 'en-US';
          enUtterance.rate = rateVal;

          enUtterance.onend = () => {
            if (isReadingAll) {
              setTimeout(() => playBilingualSequence(idx + 1), 600);
            } else {
              if (plP) plP.classList.remove('ring-2', 'ring-indigo-500');
              if (enP) enP.classList.remove('ring-2', 'ring-indigo-500');
            }
          };

          window.speechSynthesis.speak(enUtterance);
        }, 450);
      };

      window.speechSynthesis.speak(plUtterance);
    }, 50);
  }

  document.getElementById('btn-read-all').addEventListener('click', () => {
    isReadingAll = true;
    playBilingualSequence(0);
  });

  // =========================================================================
  // 5. Synchronized Scroll Between Panels
  // =========================================================================
  let isSyncingLeft = false;
  let isSyncingRight = false;

  polishPanel.addEventListener('scroll', () => {
    if (!syncScrollCheckbox.checked || isSyncingLeft) return;
    isSyncingRight = true;
    const percentage = polishPanel.scrollTop / (polishPanel.scrollHeight - polishPanel.clientHeight);
    englishPanel.scrollTop = percentage * (englishPanel.scrollHeight - englishPanel.clientHeight);
    setTimeout(() => isSyncingRight = false, 50);
  });

  englishPanel.addEventListener('scroll', () => {
    if (!syncScrollCheckbox.checked || isSyncingRight) return;
    isSyncingLeft = true;
    const percentage = englishPanel.scrollTop / (englishPanel.scrollHeight - englishPanel.clientHeight);
    polishPanel.scrollTop = percentage * (polishPanel.scrollHeight - polishPanel.clientHeight);
    setTimeout(() => isSyncingLeft = false, 50);
  });

  // Font Size Adjusters
  document.getElementById('btn-font-inc').addEventListener('click', () => {
    currentFontSize = Math.min(26, currentFontSize + 2);
    document.querySelectorAll('.doc-para p').forEach(p => p.style.fontSize = `${currentFontSize}px`);
  });

  document.getElementById('btn-font-dec').addEventListener('click', () => {
    currentFontSize = Math.max(12, currentFontSize - 2);
    document.querySelectorAll('.doc-para p').forEach(p => p.style.fontSize = `${currentFontSize}px`);
  });

  // PDF File Input
  fileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    if (file.type === 'application/pdf') {
      const reader = new FileReader();
      reader.onload = async function() {
        try {
          const typedarray = new Uint8Array(this.result);
          const pdf = await window.pdfjsLib.getDocument(typedarray).promise;
          let fullText = '';
          for (let i = 1; i <= pdf.numPages; i++) {
            const page = await pdf.getPage(i);
            const textContent = await page.getTextContent();
            fullText += textContent.items.map(item => item.str).join(' ') + '\n';
          }
          loadDocumentText(fullText, file.name);
        } catch(err) {
          alert("Could not extract text from PDF. Try pasting text manually.");
        }
      };
      reader.readAsArrayBuffer(file);
    }
  });

  // Paste Text Modal
  document.getElementById('btn-paste-modal').addEventListener('click', () => {
    pasteModal.classList.remove('hidden');
    pasteModal.classList.add('flex');
  });
  document.getElementById('btn-close-paste').addEventListener('click', () => {
    pasteModal.classList.add('hidden');
    pasteModal.classList.remove('flex');
  });
  document.getElementById('btn-cancel-paste').addEventListener('click', () => {
    pasteModal.classList.add('hidden');
    pasteModal.classList.remove('flex');
  });
  document.getElementById('btn-submit-paste').addEventListener('click', () => {
    const text = pasteInput.value.trim();
    if (text) {
      pasteModal.classList.add('hidden');
      pasteModal.classList.remove('flex');
      loadDocumentText(text, "Pasted Homework Worksheet");
    }
  });

  // Sample Selection
  sampleSelect.addEventListener('change', (e) => {
    const sample = SAMPLES[e.target.value];
    if (sample) loadDocumentText(sample.text, sample.title);
  });

  // Load default demo on start
  loadDocumentText(SAMPLES.math.text, SAMPLES.math.title);
</script>
